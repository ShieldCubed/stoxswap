{
  "version": 2,
  "rewrites": [
    { "source": "/anonhost", "destination": "https://anonhost.vercel.app/anonhost" },
    { "source": "/anonhost/:path*", "destination": "https://anonhost.vercel.app/anonhost/:path*" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/track", "destination": "/track.html" },
    { "source": "/how", "destination": "/how.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ]
}
